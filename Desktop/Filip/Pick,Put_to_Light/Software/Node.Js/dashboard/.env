# URL of the Node.js backend server.
# Default: localhost (works when the browser runs on the same PC as the server).
# To access the dashboard from another device (tablet, phone, etc.):
#   1. Find this PC's IP with: ipconfig   (look for IPv4 Address)
#   2. Create a file called .env.local next to this file and put:
#        REACT_APP_SERVER_URL=http://192.168.X.X:5000
#   .env.local is not committed to git — it stays on your machine only.
REACT_APP_SERVER_URL=http://localhost:5000
